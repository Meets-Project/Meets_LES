---
config:
  layout: elk
  elk:
    nodePlacementStrategy: NETWORK_SIMPLEX
  look: neo
  theme: redux-color
  themeVariables:
    fontSize: 22px
  er:
    entityPadding: 18
---
erDiagram
  direction LR
  users {
    uuid id PK
    varchar name
    timestamptz created_at
    varchar account_type
    varchar status
  }
  posts {
    uuid id PK
    uuid author_id FK
    timestamptz created_at
    varchar type
    varchar title
  }
  post_likes {
    uuid user_id PK,FK
    uuid post_id PK,FK
    timestamptz created_at
  }
  post_comments {
    uuid id PK
    uuid post_id FK
    uuid event_id FK
    uuid user_id FK
    text content
    timestamptz created_at
  }
  content_shares {
    bigint id PK
    uuid user_id FK
    varchar content_type
    uuid content_id
    timestamptz created_at
  }
  events {
    uuid id PK
    uuid author_id FK
    varchar title
    timestamptz created_at
    date event_date
    time event_end_time
  }
  event_participants {
    uuid event_id PK,FK
    uuid user_id PK,FK
    varchar status
    timestamptz created_at
  }
  event_ratings {
    bigint id PK
    uuid event_id FK
    uuid rater_id FK
    numeric stars
    varchar comment
    varchar visibility
    timestamptz created_at
    timestamptz updated_at
  }
  presentation_ratings {
    bigint id PK
    varchar presentation_id
    uuid post_id FK
    uuid rater_id FK
    uuid speaker_id FK
    numeric stars
    jsonb skills
    varchar comment
    timestamptz created_at
    timestamptz updated_at
    varchar visibility
  }
  reports {
    uuid id PK
    varchar status
    timestamptz created_at
  }
  users ||--o{ posts : "author_id"
  users ||--o{ post_likes : "user_id"
  posts ||--o{ post_likes : "post_id"
  posts ||--o{ post_comments : "post_id"
  events ||--o{ post_comments : "event_id"
  users ||--o{ post_comments : "user_id"
  users ||--o{ content_shares : "user_id"
  users ||--o{ events : "author_id"
  events ||--o{ event_participants : "event_id"
  users ||--o{ event_participants : "user_id"
  events ||--o{ event_ratings : "event_id"
  users ||--o{ event_ratings : "rater_id"
  posts ||--o{ presentation_ratings : "post_id"
  users ||--o{ presentation_ratings : "rater_id"
  users ||--o{ presentation_ratings : "speaker_id"
  style users fill:#fdf4ff,stroke:#c026d3
  style posts fill:#ecfeff,stroke:#0891b2
  style post_likes fill:#f0f9ff,stroke:#0284c7
  style post_comments fill:#f0f9ff,stroke:#0284c7
  style content_shares fill:#f0f9ff,stroke:#0284c7
  style events fill:#f0fdf4,stroke:#16a34a
  style event_participants fill:#f7fee7,stroke:#65a30d
  style event_ratings fill:#eff6ff,stroke:#2563eb
  style presentation_ratings fill:#eef2ff,stroke:#4f46e5
  style reports fill:#fefce8,stroke:#ca8a04
