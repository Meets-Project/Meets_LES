---
config:
  layout: elk
  elk:
    nodePlacementStrategy: NETWORK_SIMPLEX
  look: neo
  theme: redux-color
  themeVariables:
    fontSize: 22px
  er:
    entityPadding: 18
---
erDiagram
  direction TB
  users {
    uuid id PK
    varchar name
    varchar email
    text password_hash
    timestamptz created_at
    timestamptz updated_at
    boolean email_verified
    text email_verification_token_hash
    timestamptz email_verification_expires_at
    varchar account_type
    varchar status
    timestamptz deactivated_at
    uuid deactivated_by FK
    varchar deactivation_reason
  }
  profiles {
    uuid user_id PK,FK
    varchar role
    varchar city
    varchar address_number
    text avatar
    text bio
    timestamptz created_at
    timestamptz updated_at
  }
  settings {
    uuid user_id PK,FK
    boolean notifications_enabled
    boolean dark_mode
    timestamptz updated_at
  }
  user_connections {
    uuid user_id PK,FK
    uuid connected_user_id PK,FK
    timestamptz created_at
  }
  history {
    bigint id PK
    uuid user_id FK
    varchar type
    varchar title
    varchar subtitle
    timestamptz created_at
  }
  notifications {
    bigint id PK
    uuid user_id FK
    varchar title
    varchar body
    timestamptz read_at
    timestamptz created_at
    varchar target_type
    text target_id
    text target_token
  }
  chats {
    uuid id PK
    varchar name
    varchar preview
    timestamptz created_at
  }
  chat_members {
    uuid chat_id PK,FK
    uuid user_id PK,FK
    integer unread
  }
  chat_messages {
    uuid id PK
    uuid chat_id FK
    uuid sender_id FK
    text content
    timestamptz created_at
  }
  users ||--|| profiles : "user_id"
  users ||--|| settings : "user_id"
  users ||--o{ user_connections : "user_id"
  users ||--o{ user_connections : "connected_user_id"
  users ||--o{ history : "user_id"
  users ||--o{ notifications : "user_id"
  chats ||--o{ chat_members : "chat_id"
  users ||--o{ chat_members : "user_id"
  chats ||--o{ chat_messages : "chat_id"
  users ||--o{ chat_messages : "sender_id"
  style users fill:#fdf4ff,stroke:#c026d3
  style profiles fill:#fff7ed,stroke:#ea580c
  style settings fill:#f8fafc,stroke:#64748b
  style user_connections fill:#ffffff,stroke:#334155
  style history fill:#ffffff,stroke:#334155
  style notifications fill:#fffbeb,stroke:#d97706
  style chats fill:#ffffff,stroke:#334155
  style chat_members fill:#ffffff,stroke:#334155
  style chat_messages fill:#ffffff,stroke:#334155
