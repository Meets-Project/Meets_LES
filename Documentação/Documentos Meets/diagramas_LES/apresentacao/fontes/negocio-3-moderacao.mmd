---
config:
  look: neo
  theme: redux-color
  themeVariables:
    edgeLabelBackground: '#ffffff'
    fontSize: 22px
  flowchart:
    nodeSpacing: 28
    rankSpacing: 46
    wrappingWidth: 230
    subGraphTitleMargin:
      top: 10
      bottom: 14
---
flowchart TB
  subgraph L1[" "]
    direction LR
    ini(("Início"))
    u1["<b>Usuário</b><br/>encontra post, evento ou perfil impróprio e toca em Denunciar"]
    u2["<b>Usuário</b><br/>escolhe o motivo e descreve, se quiser"]
    s1{"Conteúdo próprio ou denúncia aberta repetida?"}
    s2["<b>Sistema</b><br/>recusa e informa o motivo"]
    f1((("Fim")))
    s3["<b>Sistema</b><br/>registra como Pendente e avisa os administradores"]
    d1["<b>Administrador</b><br/>abre a fila e inicia a análise (Em análise)"]
    cA1(("A"))
    ini --> u1 --> u2 --> s1
    s1 -- sim --> s2 --> f1
    s1 -- não --> s3 --> d1 --> cA1
  end
  subgraph L2[" "]
    direction LR
    cA2(("A"))
    d2{"Há violação das regras?"}
    d3["<b>Administrador</b><br/>marca Improcedente: o conteúdo continua"]
    d4["<b>Administrador</b><br/>marca Procedente e escolhe a ação: remover, advertir ou desativar a conta"]
    s4["<b>Sistema</b><br/>executa a ação e avisa o autor"]
    s5["<b>Sistema</b><br/>registra a decisão no log de administração"]
    s6["<b>Sistema</b><br/>fecha as outras denúncias abertas do mesmo alvo"]
    u3["<b>Usuário</b><br/>recebe o resultado"]
    fim((("Fim")))
    cA2 --> d2
    d2 -- não --> d3 --> s5
    d2 -- sim --> d4 --> s4 --> s5
    s5 --> s6 --> u3 --> fim
  end
  L1 ~~~ L2
  class u1,u2,u3 part
  class d1,d3,d4 adm
  class s2,s3,s4,s5,s6 sis
  class s1,d2 dec
  class ini ini
  class f1,fim fim
  class cA1,cA2 con
  classDef org fill:#f0fdfa,stroke:#0d9488,color:#0f172a
  classDef part fill:#fdf4ff,stroke:#c026d3,color:#0f172a
  classDef sis fill:#eff6ff,stroke:#2563eb,color:#0f172a
  classDef adm fill:#fff7ed,stroke:#ea580c,color:#0f172a
  classDef dec fill:#fefce8,stroke:#ca8a04,color:#0f172a
  classDef ini fill:#111827,stroke:#111827,color:#ffffff
  classDef fim fill:#ffffff,stroke:#111827,stroke-width:4px,color:#111827
  classDef con fill:#ffffff,stroke:#111827,color:#111827
  style L1 fill:none,stroke:none
  style L2 fill:none,stroke:none
