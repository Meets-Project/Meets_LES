---
config:
  look: neo
  theme: redux-color
  themeVariables:
    edgeLabelBackground: '#ffffff'
    fontSize: 22px
  flowchart:
    nodeSpacing: 28
    rankSpacing: 46
    wrappingWidth: 230
    subGraphTitleMargin:
      top: 10
      bottom: 14
---
flowchart TB
  subgraph L1[" "]
    direction LR
    ini(("Início"))
    a1["<b>Participante</b><br/>abre a avaliação pelo lembrete, pelo evento no feed ou pelo calendário"]
    d1{"Participou do evento?"}
    d2{"O evento já terminou?"}
    e1["<b>Sistema</b><br/>informa que só quem participou pode avaliar após o término"]
    f1((("Fim")))
    a2["<b>Sistema</b><br/>exibe 1 a 5 estrelas, comentário e opção pública ou anônima"]
    cA1(("A"))
    ini --> a1 --> d1
    d1 -- não --> e1 --> f1
    d1 -- sim --> d2
    d2 -- não --> e1
    d2 -- sim --> a2 --> cA1
  end
  subgraph L2[" "]
    direction LR
    cA2(("A"))
    a3["<b>Participante</b><br/>escolhe a nota, escreve o comentário e confirma"]
    d3{"Nota entre 1 e 5?"}
    e2["<b>Sistema</b><br/>pede para escolher a nota"]
    d4{"Já havia avaliado?"}
    a4["<b>Sistema</b><br/>atualiza a avaliação anterior"]
    a5["<b>Sistema</b><br/>registra a nova avaliação"]
    a6["<b>Sistema</b><br/>recalcula a média e mostra a confirmação"]
    fim((("Fim")))
    cA2 --> a3 --> d3
    d3 -- não --> e2 --> a3
    d3 -- sim --> d4
    d4 -- sim --> a4 --> a6
    d4 -- não --> a5 --> a6
    a6 --> fim
  end
  L1 ~~~ L2
  class a1,a3 part
  class e1,a2,e2,a4,a5,a6 sis
  class d1,d2,d3,d4 dec
  class ini ini
  class f1,fim fim
  class cA1,cA2 con
  classDef org fill:#f0fdfa,stroke:#0d9488,color:#0f172a
  classDef part fill:#fdf4ff,stroke:#c026d3,color:#0f172a
  classDef sis fill:#eff6ff,stroke:#2563eb,color:#0f172a
  classDef adm fill:#fff7ed,stroke:#ea580c,color:#0f172a
  classDef dec fill:#fefce8,stroke:#ca8a04,color:#0f172a
  classDef ini fill:#111827,stroke:#111827,color:#ffffff
  classDef fim fill:#ffffff,stroke:#111827,stroke-width:4px,color:#111827
  classDef con fill:#ffffff,stroke:#111827,color:#111827
  style L1 fill:none,stroke:none
  style L2 fill:none,stroke:none
