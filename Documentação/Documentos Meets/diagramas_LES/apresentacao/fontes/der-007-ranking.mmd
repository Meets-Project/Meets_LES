---
config:
  look: neo
  theme: redux-color
  themeVariables:
    fontSize: 22px
  er:
    entityPadding: 18
---
erDiagram
  direction LR
  users {
    uuid id PK
    varchar name
    varchar email
    varchar account_type
    varchar status
  }
  profiles {
    uuid user_id PK,FK
    varchar role
    text avatar
  }
  presentation_ratings {
    bigint id PK
    varchar presentation_id
    uuid post_id FK
    uuid rater_id FK
    uuid speaker_id FK
    numeric stars
    jsonb skills
    varchar comment
    timestamptz created_at
    timestamptz updated_at
    varchar visibility
  }
  users ||--|| profiles : "user_id"
  users ||--o{ presentation_ratings : "rater_id"
  users ||--o{ presentation_ratings : "speaker_id"
  style users fill:#fdf4ff,stroke:#c026d3
  style profiles fill:#fff7ed,stroke:#ea580c
  style presentation_ratings fill:#eef2ff,stroke:#4f46e5
