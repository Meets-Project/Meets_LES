---
config:
  look: neo
  theme: redux-color
  themeVariables:
    edgeLabelBackground: '#ffffff'
    fontSize: 22px
  flowchart:
    nodeSpacing: 28
    rankSpacing: 46
    wrappingWidth: 230
    subGraphTitleMargin:
      top: 10
      bottom: 14
---
flowchart TB
  subgraph L1[" "]
    direction LR
    ini(("Início"))
    a1["<b>Autor</b><br/>escreve o texto, escolhe imagem opcional e pode mencionar um evento"]
    a2["<b>Autor</b><br/>escolhe quem vê: público, seguidores, selecionados ou só com link"]
    s1{"Texto preenchido e imagem no limite?"}
    s2["<b>Sistema</b><br/>pede correção"]
    s3["<b>Sistema</b><br/>publica e mostra no feed só para quem pode ver"]
    m1{"Interação"}
    m2["<b>Membro</b><br/>curte ou descurte"]
    m3["<b>Membro</b><br/>comenta"]
    m4["<b>Membro</b><br/>compartilha"]
    m5["<b>Membro</b><br/>salva ou favorita"]
    cA1(("A"))
    ini --> a1 --> a2 --> s1
    s1 -- não --> s2 --> a1
    s1 -- sim --> s3 --> m1
    m1 --> m2 --> cA1
    m1 --> m3 --> cA1
    m1 --> m4 --> cA1
    m1 --> m5 --> cA1
  end
  subgraph L2[" "]
    direction LR
    cA2(("A"))
    s5["<b>Sistema</b><br/>se for compartilhamento, gera o link e registra"]
    s4["<b>Sistema</b><br/>atualiza contadores e o histórico"]
    a3{"Autor quer alterar?"}
    a4["<b>Autor</b><br/>edita o post (volta a ser publicado)"]
    a5["<b>Autor</b><br/>exclui o post"]
    fim((("Fim")))
    cA2 --> s5 --> s4 --> a3
    a3 -- editar --> a4 --> fim
    a3 -- excluir --> a5 --> fim
    a3 -- não --> fim
  end
  L1 ~~~ L2
  class a1,a2,a4,a5 org
  class m2,m3,m4,m5 part
  class s2,s3,s4,s5 sis
  class s1,m1,a3 dec
  class ini ini
  class fim fim
  class cA1,cA2 con
  classDef org fill:#f0fdfa,stroke:#0d9488,color:#0f172a
  classDef part fill:#fdf4ff,stroke:#c026d3,color:#0f172a
  classDef sis fill:#eff6ff,stroke:#2563eb,color:#0f172a
  classDef adm fill:#fff7ed,stroke:#ea580c,color:#0f172a
  classDef dec fill:#fefce8,stroke:#ca8a04,color:#0f172a
  classDef ini fill:#111827,stroke:#111827,color:#ffffff
  classDef fim fill:#ffffff,stroke:#111827,stroke-width:4px,color:#111827
  classDef con fill:#ffffff,stroke:#111827,color:#111827
  style L1 fill:none,stroke:none
  style L2 fill:none,stroke:none
