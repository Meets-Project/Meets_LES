---
config:
  look: neo
  theme: redux-color
  class:
    hideEmptyMembersBox: true
---
classDiagram
  direction LR
  class Usuario {
    <<users>>
    +uuid id
    +varchar name
  }
  class Evento {
    <<events>>
    +uuid id
    +uuid author_id
    +varchar title
    +date event_date
    +time event_time
    +time event_end_time
    +varchar location
  }
  class Participacao {
    <<event_participants>>
    +uuid event_id
    +uuid user_id
    +varchar status «host | confirmed»
  }
  class AvaliacaoEvento {
    <<event_ratings>>
    +bigint id
    +uuid event_id
    +uuid rater_id
    +numeric stars «1 a 5»
    +varchar comment
    +varchar visibility «public | anonymous»
  }
  class RatingRoutes {
    <<app.js>>
    +POST /ratings/events
    +GET /ratings/events/:eventId
  }
  class Repository {
    <<repository.js>>
    +getEventById(id, userId)
    +createEventRating(userId, dados)
    +getEventRatingSummary(eventId)
  }
  class Clock {
    <<services/clock.js>>
    +hasEnded(dateValue, timeValue)
  }
  Usuario "1" -- "0..*" Evento : organiza
  Usuario "1" -- "0..*" Participacao : participa
  Evento "1" -- "0..*" Participacao : tem
  Usuario "1" -- "0..*" AvaliacaoEvento : avalia
  Evento "1" -- "0..*" AvaliacaoEvento : recebe
  RatingRoutes ..> Repository : chama
  Repository ..> AvaliacaoEvento : grava (ON CONFLICT atualiza)
  Repository ..> Participacao : confere participação
  Repository ..> Clock : evento terminou?
  style Usuario fill:#fdf4ff,stroke:#c026d3
  style Evento fill:#f0fdf4,stroke:#16a34a
  style Participacao fill:#f7fee7,stroke:#65a30d
  style AvaliacaoEvento fill:#eff6ff,stroke:#2563eb
  style RatingRoutes fill:#fff7ed,stroke:#ea580c
  style Repository fill:#ecfeff,stroke:#0891b2
  style Clock fill:#f0f9ff,stroke:#0284c7
