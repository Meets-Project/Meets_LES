---
config:
  look: neo
  theme: redux-color
  themeVariables:
    edgeLabelBackground: '#ffffff'
    fontSize: 22px
  flowchart:
    nodeSpacing: 28
    rankSpacing: 46
    wrappingWidth: 230
    subGraphTitleMargin:
      top: 10
      bottom: 14
---
flowchart TB
  subgraph L1[" "]
    direction LR
    ini(("Início"))
    a1["<b>Usuário</b><br/>abre “Ranking” no menu"]
    a2["<b>Usuário</b><br/>escolhe o período: desde o início, 90 ou 30 dias (pode trocar a qualquer momento)"]
    s1["<b>Sistema</b><br/>busca as avaliações de apresentação do período (só contas ativas)"]
    d1{"Há avaliações?"}
    e1["<b>Sistema</b><br/>informa que o ranking ainda não tem dados"]
    f1((("Fim")))
    cA1(("A"))
    ini --> a1 --> a2 --> s1 --> d1
    d1 -- não --> e1 --> f1
    d1 -- sim --> cA1
  end
  subgraph L2[" "]
    direction LR
    cA2(("A"))
    s2["<b>Sistema</b><br/>calcula por apresentador: média por atributo, estrelas e pontuação geral"]
    s3["<b>Sistema</b><br/>ordena: pontuação, estrelas, total de avaliações, nome"]
    s4["<b>Sistema</b><br/>exibe o pódio e a lista"]
    d2{"Toca em um apresentador?"}
    s5["<b>Sistema</b><br/>abre o perfil com as médias por atributo"]
    fim((("Fim")))
    cA2 --> s2 --> s3 --> s4 --> d2
    d2 -- sim --> s5 --> fim
    d2 -- não --> fim
  end
  L1 ~~~ L2
  class a1,a2 part
  class s1,e1,s2,s3,s4,s5 sis
  class d1,d2 dec
  class ini ini
  class f1,fim fim
  class cA1,cA2 con
  classDef org fill:#f0fdfa,stroke:#0d9488,color:#0f172a
  classDef part fill:#fdf4ff,stroke:#c026d3,color:#0f172a
  classDef sis fill:#eff6ff,stroke:#2563eb,color:#0f172a
  classDef adm fill:#fff7ed,stroke:#ea580c,color:#0f172a
  classDef dec fill:#fefce8,stroke:#ca8a04,color:#0f172a
  classDef ini fill:#111827,stroke:#111827,color:#ffffff
  classDef fim fill:#ffffff,stroke:#111827,stroke-width:4px,color:#111827
  classDef con fill:#ffffff,stroke:#111827,color:#111827
  style L1 fill:none,stroke:none
  style L2 fill:none,stroke:none
